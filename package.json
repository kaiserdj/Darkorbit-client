{
    "name": "darkorbit-client",
    "version": "3.1.0",
    "description": "Open source darkorbit client",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/emrementese/darkorbit-client-secure.git"
    },
    "scripts": {
        "build:preload": "esbuild inject/preload.js --bundle --platform=browser --format=cjs --target=chrome87 --external:electron --outfile=inject/dist/preload.js --log-level=warning",
        "prestart": "npm run build:preload",
        "start": "electron .",
        "predev": "npm run build:preload",
        "dev": "electron . --d",
        "test": "node --test \"test/unit/**/*.test.js\"",
        "pretest:e2e": "npm run build:preload",
        "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
        "lint": "eslint .",
        "postinstall": "node scripts/electron-x64-mac.js && npm run build:preload && electron-builder install-app-deps",
        "electron:x64": "node scripts/electron-x64-mac.js --force",
        "prebuild": "npm run build:preload",
        "build": "electron-builder --publish=always",
        "prerelease": "npm run build:preload",
        "release": "electron-builder --publish always",
        "prelocal-build": "npm run build:preload",
        "local-build": "electron-builder",
        "prepack": "npm run build:preload",
        "pack": "electron-builder --dir"
    },
    "author": "Kaiserdj",
    "license": "SEE LICENSE IN LICENSE",
    "devDependencies": {
        "electron": "11.5.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0"
    },
    "dependencies": {
        "axios": "1.20.0",
        "electron-context-menu": "^3.6.1",
        "electron-positioner": "^4.1.0",
        "electron-process-manager": "github:kaiserdj/electron-process-manager",
        "electron-progressbar": "^2.2.1",
        "electron-settings": "^4.0.4",
        "electron-updater": "^6.8.9",
        "menubar": "^9.5.3",
        "sweetalert2": "11.4.8",
        "ws": "^8.22.0",
        "xml2js": "^0.6.2",
        "yargs": "^17.7.3"
    },
    "build": {
        "appId": "com.DarkOrbitClient.Kaiserdj",
        "productName": "DarkOrbit Client",
        "files": [
            "**/*",
            "!scripts/**",
            "!test/**",
            "!eslint.config.js",
            "!.context/**",
            "!.vscode/**",
            "!dist/**"
        ],
        "extraResources": [
            "./flash/**",
            "./darkDev/packet_dumper.py"
        ],
        "directories": {
            "buildResources": "assets",
            "output": "dist"
        },
        "protocols": {
            "name": "darkorbit-client",
            "schemes": [
                "darkorbit-client"
            ]
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "public.app-category.games",
            "extendInfo": "darkorbit-client"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Game"
        },
        "publish": [
            {
                "provider": "github",
                "releaseType": "draft",
                "owner": "emrementese",
                "repo": "darkorbit-client-secure"
            }
        ]
    },
    "overrides": {
        "electron": {
            "@electron/get": "^2.0.3"
        }
    }
}
